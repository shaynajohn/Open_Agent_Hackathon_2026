# mock uses local sample profiles and does not call the network.
# exa and tavily search the public web. Candidate extraction from those
# pages is not implemented yet, so they will not invent people.
SEARCH_PROVIDER=mock

# mock | openai | nightshift
LLM_PROVIDER=mock

# Required only when SEARCH_PROVIDER=exa
EXA_API_KEY=

# Required only when SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Required only when you start calling the OpenAI client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Browser origins allowed to call this API during local development.
# MeetMind's web app is on 3010 so a local Zetaris UI can keep port 3000.
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# Nightshift on this machine. NVIDIA keys stay in Nightshift's Providers tab.
# LLM_PROVIDER=nightshift
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL=meterless/auto
METERLESS_APP=meetmind

# Zetaris. Local Docker REST is port 8888. An AWS cluster uses the API base
# from the cluster Access page, ending in /api/v1.0. If you only have the
# Gateway sign-in URL, set ZETARIS_BASE_URL to that origin and leave REST
# at the local default.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
