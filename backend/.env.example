# mock uses local sample profiles and does not call the network.
# exa and tavily search the public web. Candidate extraction from those
# pages is not implemented yet, so they will not invent people.
SEARCH_PROVIDER=mock

# mock keeps intent parsing and outreach on local logic.
# openai is available through app/services/llm.py and is not wired in yet.
LLM_PROVIDER=mock

# Required only when SEARCH_PROVIDER=exa
EXA_API_KEY=

# Required only when SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Required only when you start calling the OpenAI client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Browser origins allowed to call this API during local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
