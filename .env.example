# Copy the backend block into backend/.env and the frontend block into frontend/.env.local.
# Never commit real keys. The mock app runs with these defaults and no credentials.

# --- backend/.env ---
SEARCH_PROVIDER=mock
LLM_PROVIDER=mock
EXA_API_KEY=
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- frontend/.env.local ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- extension ---
# The popup reads its web app URL from extension/src/popup.ts (WEB_APP_URL).
# It does not call the API and does not use these keys.
