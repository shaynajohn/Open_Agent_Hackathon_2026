# Copy the backend block into backend/.env and the frontend block into frontend/.env.local.
# Never commit real keys. The mock app runs with these defaults and no credentials.

# --- backend/.env ---
SEARCH_PROVIDER=mock
LLM_PROVIDER=mock
EXA_API_KEY=
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# Nightshift. Do not put an NVIDIA key here.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL=meterless/auto

# Zetaris. AWS clusters: replace REST_URL with the cluster API base.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=

# --- frontend/.env.local ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- extension ---
# The popup reads its web app URL from extension/src/popup.ts (WEB_APP_URL).
# It is http://localhost:3010. The extension does not call the API.
